default_platform(:mac)

platform :mac do
  desc "Upload metadata and screenshots to App Store Connect"
  desc "app_version を指定すると、そのバージョンを ASC に作成して適用する"
  desc "例: fastlane metadata app_version:1.4.0"
  lane :metadata do |options|
    deliver(
      api_key_path: "fastlane/api_key.json",
      app_version: options[:app_version],
      skip_binary_upload: true,
      skip_screenshots: false,
      # 毎回「全削除→全アップ」でクリーンに上げ直す。
      # NOTE: deliver はアップ直後の存在確認が早すぎて毎回 missing と誤判定し、
      # リトライで必ずスクショが二重化する（sync_screenshots は fastlane 2.236.1 時点で
      # クラッシュし使えない）。そのため下の dedupe_screenshots で重複を掃除する。
      overwrite_screenshots: true,
      force: true,
      platform: "osx",
      precheck_include_in_app_purchases: false
    )
    # deliver のバグで二重化したスクショを除去し、ローカルの内容（各1枚）に揃える
    dedupe_screenshots(options)
  end

  desc "重複したスクリーンショットを削除する（同一ファイル名は1枚だけ残す）"
  desc "deliver のアップ後検証バグで二重化したぶんを掃除する保険"
  lane :dedupe_screenshots do |options|
    require "spaceship"
    # lane 実行時の CWD は fastlane/ なのでこのパスは fastlane/api_key.json を指す
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from_json_file("api_key.json")

    app = Spaceship::ConnectAPI::App.find("com.himatsubu.Clipnyx")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    UI.user_error!("編集可能な MAC_OS バージョンが見つかりません") if version.nil?
    UI.message("対象バージョン: #{version.version_string}")

    removed = 0
    version.get_app_store_version_localizations.each do |loc|
      loc.get_app_screenshot_sets.each do |set|
        shots = set.app_screenshots || []
        # 同一ファイル名でグループ化し、正常処理済み(COMPLETE)を優先して1枚だけ残す
        shots.group_by(&:file_name).each do |fname, group|
          keeper = group.find(&:complete?) || group.first
          group.each do |shot|
            next if shot.id == keeper.id
            UI.message("削除: #{loc.locale} / #{set.screenshot_display_type} / #{fname}")
            shot.delete!
            removed += 1
          end
        end
      end
    end
    UI.success("重複スクリーンショットを #{removed} 枚削除しました")
  end

  desc "Upload metadata only (no screenshots)"
  lane :metadata_only do |options|
    deliver(
      api_key_path: "fastlane/api_key.json",
      app_version: options[:app_version],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      platform: "osx",
      precheck_include_in_app_purchases: false
    )
  end

  desc "App プレビュー動画を App Store Connect にアップロードする"
  desc "fastlane/app_previews/<locale>/*.mp4（ファイル名に DESKTOP を含む）を Mac の DESKTOP プレビューに上げる"
  desc "deliver の app_previews_path は本バージョンの spaceship で DESKTOP の解像度検証が欠落しており弾かれるため、Spaceship で直接アップロードする"
  desc "例: fastlane preview"
  lane :preview do |_options|
    require "spaceship"
    # lane 実行時の CWD は fastlane/ なのでこのパスは fastlane/api_key.json を指す
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from_json_file("api_key.json")
    desktop = Spaceship::ConnectAPI::AppPreviewSet::PreviewType::DESKTOP

    app = Spaceship::ConnectAPI::App.find("com.himatsubu.Clipnyx")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    UI.user_error!("編集可能な MAC_OS バージョンが見つかりません") if version.nil?
    UI.message("対象バージョン: #{version.version_string}")

    base = "app_previews"
    UI.user_error!("#{base} ディレクトリが見つかりません") unless Dir.exist?(base)

    localizations = version.get_app_store_version_localizations
    uploaded = 0

    Dir.children(base).sort.each do |locale|
      dir = File.join(base, locale)
      next unless File.directory?(dir)
      videos = Dir.children(dir).select { |f| %w[.mp4 .mov .m4v].include?(File.extname(f).downcase) }.sort
      next if videos.empty?

      loc = localizations.find { |l| l.locale == locale }
      unless loc
        UI.important("ロケール #{locale} は ASC に存在しません。スキップ")
        next
      end

      # DESKTOP プレビューセットを取得/作成し、既存を全削除してから上げ直す（上書き）
      set = loc.get_app_preview_sets(includes: "appPreviews").find { |s| s.preview_type == desktop }
      if set
        (set.app_previews || []).each do |p|
          UI.message("既存プレビュー削除: #{locale} / #{p.file_name}")
          p.delete!
        end
      else
        set = loc.create_app_preview_set(attributes: { previewType: desktop })
      end
      # 削除直後の状態で取り直す
      set = loc.get_app_preview_sets(includes: "appPreviews").find { |s| s.preview_type == desktop }

      videos.each do |f|
        path = File.join(dir, f)
        UI.message("アップロード: #{locale} / #{f} → DESKTOP")
        # wait_for_processing: false にする。true だと spaceship が ASC の変換完了を
        # タイムアウト無しの 30 秒間隔ポーリングで延々待ち続けてハングするため。
        # 動画のバイト転送は完了し、変換は ASC 側で非同期に進む。
        set.upload_preview(path: path, wait_for_processing: false)
        uploaded += 1
      end
    end

    UI.success("App プレビュー動画を #{uploaded} 本アップロードしました")
  end

  desc "App プレビュー動画の ASC 側処理状態を表示する（診断用）"
  lane :preview_status do |_options|
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from_json_file("api_key.json")
    desktop = Spaceship::ConnectAPI::AppPreviewSet::PreviewType::DESKTOP

    app = Spaceship::ConnectAPI::App.find("com.himatsubu.Clipnyx")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    UI.user_error!("編集可能な MAC_OS バージョンが見つかりません") if version.nil?
    UI.message("対象バージョン: #{version.version_string}")

    found = false
    version.get_app_store_version_localizations.each do |loc|
      loc.get_app_preview_sets(includes: "appPreviews").select { |s| s.preview_type == desktop }.each do |set|
        (set.app_previews || []).each do |p|
          found = true
          state = (p.asset_delivery_state || {})["state"]
          UI.message("#{loc.locale} / #{p.file_name}: state=#{state} video_url=#{p.video_url ? 'あり' : 'なし'}")
        end
      end
    end
    UI.important("DESKTOP プレビューがまだ見つかりません") unless found
  end
end
