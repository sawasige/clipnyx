default_platform(:mac)

platform :mac do
  desc "Upload metadata and screenshots to App Store Connect"
  desc "app_version を指定すると、そのバージョンを ASC に作成して適用する"
  desc "例: fastlane metadata app_version:1.4.0"
  lane :metadata do |options|
    deliver(
      api_key_path: "fastlane/api_key.json",
      app_version: options[:app_version],
      skip_binary_upload: true,
      skip_screenshots: false,
      # 既存スクリーンショットを削除してから上げ直す（false だと追加になる）
      overwrite_screenshots: true,
      force: true,
      platform: "osx",
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload metadata only (no screenshots)"
  lane :metadata_only do |options|
    deliver(
      api_key_path: "fastlane/api_key.json",
      app_version: options[:app_version],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      platform: "osx",
      precheck_include_in_app_purchases: false
    )
  end
end
